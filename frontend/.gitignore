# System files
.DS_Store
Thumbs.db

# Environment
.env
.env.*
!.env.example

# Local environment config (contains API keys — copy from environment.example.ts)
src/environments/environment.ts

# CesiumJS assets (copied at build time)
/src/assets/cesium
