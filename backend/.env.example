# ── MongoDB ──────────────────────────────────────────────────────────────────
# Credentials used by both the MongoDB container and the backend connection URI.
MONGO_ROOT_USERNAME=some_admin
MONGO_ROOT_PASSWORD=some_password

# For Docker (full stack via docker compose): use "mongodb" as hostname
MONGO_URI=mongodb://some_admin:some_password@mongodb:27017/agora?authSource=admin
# For local development (without Docker): use "localhost" as hostname
# MONGO_URI=mongodb://some_admin:some_password@localhost:27017/agora?authSource=admin

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3000
CORS_ORIGIN=http://localhost:4200

# ── Logging ──────────────────────────────────────────────────────────────────
# Levels: error | warn | info | http | verbose | debug
LOG_LEVEL=info
LOG_FILE_PATH=logs/error.log

# ── Search ───────────────────────────────────────────────────────────────────
MAX_EVENTS_LIMIT=20000

# ── Scheduler intervals (milliseconds, 0 = disabled) ─────────────────────────
SCHEDULER_USGS_INTERVAL=300000
# IBTrACS itself (not just our polling) is only refreshed ~3x/week by NOAA
# (Sun/Tue/Thu), with up to ~1 day of lag before it's posted — unlike USGS,
# there's no point polling more often than once a day.
SCHEDULER_IBTRACS_INTERVAL=86400000
SCHEDULER_COPERNICUS_INTERVAL=86400000
SCHEDULER_NASA_INTERVAL=86400000
SCHEDULER_SMITHSONIAN_INTERVAL=604800000

# ── Trivia AI (not yet implemented) ──────────────────────────────────────────
SCHEDULER_TRIVIA_INTERVAL=3600000
AI_API_KEY=
AI_API_URL=