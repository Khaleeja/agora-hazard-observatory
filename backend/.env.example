# ── MongoDB ──────────────────────────────────────────────────────────────────
# Credentials used by both the MongoDB container and the backend connection URI.
MONGO_ROOT_USERNAME=some_admin
MONGO_ROOT_PASSWORD=some_password

# For Docker (full stack via docker compose): use "mongodb" as hostname
MONGO_URI=mongodb://some_admin:some_password@mongodb:27017/agora?authSource=admin
# For local development (without Docker): use "localhost" as hostname
# MONGO_URI=mongodb://some_admin:some_password@localhost:27017/agora?authSource=admin

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3000
CORS_ORIGIN=http://localhost:4200

# ── Logging ──────────────────────────────────────────────────────────────────
# Levels: error | warn | info | http | verbose | debug
LOG_LEVEL=info
LOG_FILE_PATH=logs/error.log

# ── Search ───────────────────────────────────────────────────────────────────
MAX_EVENTS_LIMIT=20000

# ── Scheduler intervals, reserved for sources without a plugin yet ──────────
# USGS and IBTrACS deliberately have NO entry here: their polling cadence is
# a fact about those sources (earthquakes happen continuously; IBTrACS
# itself only refreshes ~3x/week), not something any deployment would want
# to vary — it's a plain constant in USGSConfig.ts / IBTrACSConfig.ts
# instead. Before giving a *future* source an env var here, ask the same
# question: does its real-world update cadence actually ever change per
# deployment, or would a config constant (like the two above) be honest?
SCHEDULER_COPERNICUS_INTERVAL=1440     # minutes; 24h
SCHEDULER_NASA_INTERVAL=1440           # minutes; 24h
SCHEDULER_SMITHSONIAN_INTERVAL=10080   # minutes; 7d

# ── Trivia AI (not yet implemented) ──────────────────────────────────────────
SCHEDULER_TRIVIA_INTERVAL=60       # minutes; 1h
AI_API_KEY=
AI_API_URL=