# Root .env — orchestration-level values shared across the whole stack
# (docker-compose.yml). Backend-specific values (PORT, scheduler intervals,
# etc.) live in their own file: backend/.env.example.
#
# Copy this to .env and fill in real values before running `docker compose up`.

# ArcGIS API key used by the frontend map (basemap/imagery). Leave empty in
# development — the frontend falls back to a placeholder environment file.
ARCGIS_API_KEY=

# MongoDB root credentials — shared by the mongodb container and the
# backend's own MONGO_URI (see backend/.env.example).
MONGO_ROOT_USERNAME=
MONGO_ROOT_PASSWORD=

# Set to 27017 to expose MongoDB on localhost (e.g. for MongoDB Compass).
# Leave empty to keep it reachable only from other containers.
MONGO_COMPASS_PORT=
